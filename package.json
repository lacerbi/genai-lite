{
  "name": "genai-lite",
  "version": "0.17.2",
  "description": "A lightweight, portable toolkit for interacting with various Generative AI APIs.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./prompting": {
      "import": "./dist/prompting/index.js",
      "require": "./dist/prompting/index.js",
      "types": "./dist/prompting/index.d.ts"
    },
    "./tokenizer-loader": {
      "import": "./dist/llm/tokenization/loader/index.js",
      "require": "./dist/llm/tokenization/loader/index.js",
      "types": "./dist/llm/tokenization/loader/index.d.ts"
    },
    "./tokenizer-recipes": {
      "import": "./dist/llm/tokenization/recipes/index.js",
      "require": "./dist/llm/tokenization/recipes/index.js",
      "types": "./dist/llm/tokenization/recipes/index.d.ts"
    }
  },
  "author": "Luigi Acerbi <luigi.acerbi@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/lacerbi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacerbi/genai-lite.git"
  },
  "bugs": {
    "url": "https://github.com/lacerbi/genai-lite/issues"
  },
  "homepage": "https://github.com/lacerbi/genai-lite#readme",
  "files": [
    "dist",
    "src/config/llm-presets.json",
    "src/config/image-presets.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "npm run build && jest --config jest.e2e.config.js",
    "test:e2e:reasoning": "npm run build && jest --config jest.e2e.config.js reasoning.e2e.test.ts",
    "test:packed-api": "npm run build && node scripts/verify-packed-prepared-api.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/genai": "^2.10.0",
    "@mistralai/mistralai": "^1.15.1",
    "js-tiktoken": "1.0.21",
    "openai": "^7.2.0"
  },
  "peerDependencies": {
    "@huggingface/tokenizers": "^0.1.3"
  },
  "peerDependenciesMeta": {
    "@huggingface/tokenizers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huggingface/tokenizers": "^0.1.3",
    "@types/jest": ">=30.0.0",
    "@types/node": ">=20.11.24",
    "jest": ">=30.0.4",
    "ts-jest": ">=29.4.0",
    "typescript": ">=5.3.3"
  }
}
